---
interface Props { item: any; collection: string }
const { item, collection } = Astro.props;
const d = item.data;
const href = `/${collection}/${item.id.replace(/\.(md|mdx)$/,'')}/`;
const date = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short' }).format(d.date);
---
<a class={`card ${d.size || 'medium'}`} href={href}>
  {d.image ? <img class="card-image" src={d.image} alt="" loading="lazy" /> :
  <div class="placeholder"><svg viewBox="0 0 80 80" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8"><rect x="18" y="20" width="44" height="38" rx="9"/><circle cx="31" cy="37" r="3"/><circle cx="49" cy="37" r="3"/><path d="M31 48c5 5 13 5 18 0"/></g></svg></div>}
  <div class="card-copy">
    <p class="kind">{collection}</p>
    <h2>{d.title}</h2>
    <p>{d.summary}</p>
    <div class="meta">{date}{d.duration ? ` · ${d.duration}` : ''}{d.status ? ` · ${d.status}` : ''}</div>
  </div>
</a>
