---
interface Props {
  item: any;
  collection: 'poetry' | 'robots' | 'music';
  Content: any;
}

const {
  item,
  collection,
  Content
} = Astro.props;

const data = item.data;
---

<details
  class="post"
  data-category={collection}
>
  <summary class="post-summary">
    <h2>{data.title}</h2>

    <span
      class="expand-mark"
      aria-hidden="true"
    ></span>
  </summary>

  <div class="post-expanded">
    {data.image && (
      <img
        class="entry-image"
        src={data.image}
        alt={data.title}
        loading="lazy"
      />
    )}

    {data.audio && (
      <audio
        class="entry-audio"
        controls
        preload="metadata"
        src={data.audio}
      ></audio>
    )}

    {data.video && (
      <video
        class="entry-video"
        controls
        preload="metadata"
        src={data.video}
      ></video>
    )}

    {Content && (
      <div class="post-body">
        <Content />
      </div>
    )}
  </div>
</details>