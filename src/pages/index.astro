---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Card from '../components/Card.astro';
const names = ['poetry','robots','music','video'] as const;
const groups = await Promise.all(names.map(async collection => ({ collection, items: await getCollection(collection, ({data}) => !data.draft) })));
const all = groups.flatMap(g => g.items.map(item => ({ item, collection: g.collection }))).sort((a,b) => b.item.data.date.valueOf() - a.item.data.date.valueOf());
---
<Base><Header /><main class="projects">{all.map(({item,collection}) => <Card item={item} collection={collection} />)}</main><footer>bydomingo.com</footer></Base>
