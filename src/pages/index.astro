
---
import { getCollection } from 'astro:content';
import MarkdownIt from 'markdown-it';

const markdown = new MarkdownIt({
  html: false,
  breaks: true,
  linkify: true
});

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.date.getTime() - a.data.date.getTime()
  );
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>bydomingo</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        background: #0d0d0d;
        color: #f5f3ee;
        font-family: "Crimson Pro", Georgia, serif;
        font-size: 19px;
        -webkit-font-smoothing: antialiased;
      }

      main {
        width: 100%;
        padding: 45px 5% 100px;
      }

      header {
        text-align: center;
        margin-bottom: 65px;
      }

      h1 {
        margin: 0;
        font-size: clamp(44px, 6vw, 72px);
        font-weight: 400;
        line-height: 1.1;
      }

      .site-title {
        color: inherit;
        text-decoration: none;
      }

      .pink {
        color: #d781ac;
      }

      .posts {
        width: 100%;
        border-top: 1px solid #383838;
      }

      /* POSTS */

      .post {
        position: relative;
        isolation: isolate;
        width: 100%;
        border-bottom: 1px solid #383838;
        background-color: #0d0d0d;
      }

      /*
       * Background stays anchored to the top.
       * Opening the post reveals more of the image.
       */

      .post.has-background::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;

        background-image:
          linear-gradient(
            rgba(0, 0, 0, 0.25),
            rgba(0, 0, 0, 0.25)
          ),
          var(--post-image);

        background-size:
          100% 100%,
          100% auto;

        background-position:
          top center,
          top center;

        background-repeat: no-repeat;
        opacity: 0.6;
      }

      .post > summary,
      .post > .post-content {
        position: relative;
        z-index: 1;
      }

      /* CLOSED POST */

      .post summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 15px 3px;
        cursor: pointer;
        list-style: none;
        user-select: none;
        transition: opacity 0.2s ease;
      }

      .post summary:hover {
        opacity: 0.7;
      }

      .post summary::-webkit-details-marker {
        display: none;
      }

      .post summary::marker {
        content: "";
      }

      .post-title {
        display: block;
        flex: 1;
        min-width: 0;
        font-size: 21px;
        font-weight: 400;
        line-height: 1.3;
        overflow-wrap: break-word;
      }

      .symbol {
        flex: 0 0 18px;
        width: 18px;
        text-align: center;
        font-size: 21px;
        line-height: 1;
        opacity: 0.65;
      }

      .symbol::after {
        content: "+";
      }

      .post[open] .symbol::after {
        content: "−";
      }

      /* OPEN POST */

      .post-content {
        padding: 8px 3px 28px;
        font-size: 19px;
        line-height: 1.4;
        width: 100%;
      }

      .block {
        margin: 0 0 18px;
        width: 100%;
      }

      /* RICH TEXT */

      .text-body {
        overflow-wrap: break-word;
      }

      .text-body :global(p) {
        margin: 0 0 0.65em;
      }

      .text-body :global(p:last-child) {
        margin-bottom: 0;
      }

      .text-body :global(strong) {
        font-weight: 600;
      }

      .text-body :global(em) {
        font-style: italic;
      }

      .text-body :global(del) {
        text-decoration: line-through;
      }

      .text-body :global(a) {
        color: inherit;
        text-underline-offset: 3px;
      }

      .text-body :global(h2),
      .text-body :global(h3) {
        font-weight: 600;
        line-height: 1.2;
        margin: 0.7em 0 0.35em;
      }

      .text-body :global(ul),
      .text-body :global(ol) {
        padding-left: 1.4em;
        margin: 0.5em 0;
      }

      .text-body :global(blockquote) {
        border-left: 1px solid #777;
        padding-left: 1em;
        margin: 0.8em 0;
        opacity: 0.85;
      }

      .text-body :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 0.7em auto;
      }

      .text-block.align-left {
        text-align: left;
      }

      .text-block.align-center {
        text-align: center;
      }

      .text-block.align-right {
        text-align: right;
      }

      .text-block.size-small {
        font-size: 16px;
      }

      .text-block.size-normal {
        font-size: 19px;
      }

      .text-block.size-large {
        font-size: 27px;
      }

      /* MEDIA */

      .media-block {
        display: flex;
        flex-direction: column;
      }

      .media-block.align-left {
        align-items: flex-start;
      }

      .media-block.align-center {
        align-items: center;
      }

      .media-block.align-right {
        align-items: flex-end;
      }

      .media-inner {
        max-width: 100%;
      }

      .media-block.size-small .media-inner {
        width: 30%;
      }

      .media-block.size-medium .media-inner {
        width: 50%;
      }

      .media-block.size-large .media-inner {
        width: 75%;
      }

      .media-block.size-full .media-inner {
        width: 100%;
      }

      .media-inner img,
      .media-inner video {
        display: block;
        width: 100%;
        height: auto;
      }

      .media-inner audio {
        display: block;
        width: 100%;
      }

      .media-inner figure {
        margin: 0;
      }

      .media-caption {
        margin-top: 7px;
        font-size: 15px;
        opacity: 0.65;
      }

      .empty {
        opacity: 0.5;
        padding: 18px 3px;
      }

      /* MOBILE */

      @media (max-width: 650px) {
        main {
          padding: 35px 5% 70px;
        }

        header {
          margin-bottom: 45px;
        }

        .post summary {
          padding: 14px 2px;
        }

        .post-title {
          font-size: 19px;
        }

        .post-content {
          font-size: 18px;
        }

        .media-block.size-small .media-inner {
          width: 65%;
        }

        .media-block.size-medium .media-inner,
        .media-block.size-large .media-inner {
          width: 100%;
        }
      }
    </style>
  </head>

  <body id="top">
    <main>
      <header>
        <h1>
          <a href="#top" class="site-title">
            bydomin<span class="pink">g</span>o
          </a>
        </h1>
      </header>

      <section class="posts">
        {posts.length === 0 && (
          <div class="empty">No posts yet.</div>
        )}

        {posts.map((post) => (
          <details
            class:list={[
              'post',
              {
                'has-background':
                  !!post.data.backgroundImage
              }
            ]}
            style={
              post.data.backgroundImage
                ? {
                    '--post-image': `url(${JSON.stringify(
                      post.data.backgroundImage
                    )})`
                  }
                : undefined
            }
          >
            <summary>
              <span class="post-title">
                {post.data.title}
              </span>

              <span
                class="symbol"
                aria-hidden="true"
              ></span>
            </summary>

            <div class="post-content">
              {post.data.blocks.map((block) => (
                block.type === 'text' ? (
                  <div
                    class={`block text-block align-${block.alignment} size-${block.size}`}
                  >
                    <div
                      class="text-body"
                      set:html={markdown.render(block.text || '')}
                    />
                  </div>
                ) :

                block.type === 'image' ? (
                  <div
                    class={`block media-block align-${block.alignment} size-${block.size}`}
                  >
                    <div class="media-inner">
                      <figure>
                        <img
                          src={block.src}
                          alt={block.alt || ''}
                          loading="lazy"
                        />

                        {block.caption && (
                          <figcaption class="media-caption">
                            {block.caption}
                          </figcaption>
                        )}
                      </figure>
                    </div>
                  </div>
                ) :

                block.type === 'audio' ? (
                  <div
                    class={`block media-block align-${block.alignment} size-${block.size}`}
                  >
                    <div class="media-inner">
                      <audio
                        controls
                        preload="none"
                        src={block.src}
                      >
                        Your browser does not support audio.
                      </audio>

                      {block.caption && (
                        <div class="media-caption">
                          {block.caption}
                        </div>
                      )}
                    </div>
                  </div>
                ) :

                block.type === 'video' ? (
                  <div
                    class={`block media-block align-${block.alignment} size-${block.size}`}
                  >
                    <div class="media-inner">
                      <video
                        controls
                        preload="metadata"
                        src={block.src}
                      >
                        Your browser does not support video.
                      </video>

                      {block.caption && (
                        <div class="media-caption">
                          {block.caption}
                        </div>
                      )}
                    </div>
                  </div>
                ) : null
              ))}
            </div>
          </details>
        ))}
      </section>
    </main>

    <script is:inline>
      /* RANDOM PASTEL G LETTERS */

      const colours = [
        '#d781ac',
        '#b89ad9',
        '#8fb9d4',
        '#86c8bd',
        '#99c58f',
        '#d8c778',
        '#e7ad7d',
        '#d99a98'
      ];

      function colourGs() {
        const walker = document.createTreeWalker(
          document.body,
          NodeFilter.SHOW_TEXT
        );

        const nodes = [];

        while (walker.nextNode()) {
          const node = walker.currentNode;
          const parent = node.parentElement;

          if (
            parent &&
            /g/i.test(node.textContent || '') &&
            !parent.closest(
              '.site-title, .special-letter, script, style, svg'
            )
          ) {
            nodes.push(node);
          }
        }

        nodes.forEach((node) => {
          const fragment = document.createDocumentFragment();

          for (const character of node.textContent || '') {
            if (character.toLowerCase() === 'g') {
              const span = document.createElement('span');
              span.className = 'special-letter';

              span.style.color =
                colours[Math.floor(
                  Math.random() * colours.length
                )];

              span.textContent = character;
              fragment.appendChild(span);
            } else {
              fragment.appendChild(
                document.createTextNode(character)
              );
            }
          }

          node.parentNode.replaceChild(fragment, node);
        });
      }

      colourGs();

      /* SMOOTH POST OPENING AND CLOSING */

      const reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      );

      document.querySelectorAll('.post').forEach((post) => {
        const summary = post.querySelector('summary');
        const content = post.querySelector('.post-content');

        if (!summary || !content) return;

        let animating = false;

        summary.addEventListener('click', (event) => {
          if (reducedMotion.matches) return;

          event.preventDefault();

          if (animating) return;

          animating = true;

          const wasOpen = post.open;

          const startHeight =
            post.getBoundingClientRect().height;

          if (!wasOpen) {
            post.style.height = `${startHeight}px`;
            post.open = true;
          }

          const summaryHeight = summary.offsetHeight;
          const contentHeight = content.offsetHeight;

          const endHeight = wasOpen
            ? summaryHeight + 1
            : summaryHeight + contentHeight + 1;

          post.style.overflow = 'hidden';

          const animation = post.animate(
            [
              { height: `${startHeight}px` },
              { height: `${endHeight}px` }
            ],
            {
              duration: 420,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
              fill: 'both'
            }
          );

          animation.onfinish = () => {
            if (wasOpen) {
              post.open = false;
            }

            post.style.height = '';
            post.style.overflow = '';
            animating = false;
          };

          animation.oncancel = () => {
            post.style.height = '';
            post.style.overflow = '';
            animating = false;
          };
        });
      });
    </script>
  </body>
</html>
