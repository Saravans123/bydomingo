---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Card from '../../components/Card.astro';
const collection = 'poetry';
const items = (await getCollection(collection, ({data}) => !data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title={collection}><Header /><h1 class="page-title">{collection}</h1><main class="projects">{items.map(item => <Card item={item} collection={collection} />)}</main></Base>
