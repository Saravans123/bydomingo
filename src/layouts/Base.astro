---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'bydomingo',
  description =
    'Poetry, electronics and audio by Domingo.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <meta
      name="description"
      content={description}
    />

    <title>
      {
        title === 'bydomingo'
          ? title
          : `${title} — bydomingo`
      }
    </title>

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
      rel="stylesheet"
    />

    <script
      src="https://identity.netlify.com/v1/netlify-identity-widget.js"
    ></script>

    <style is:global>
      :root {
        --cream: #f5f1e7;
        --black: #171717;
        --letter-pink: #d781ac;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;

        background:
          var(--cream);

        color:
          var(--black);

        font-family:
          "Crimson Pro",
          Georgia,
          serif;

        font-size: 18px;
        font-weight: 500;
        line-height: 1.45;
      }

      button,
      input,
      textarea,
      select {
        font: inherit;
      }

      img,
      video {
        display: block;
        max-width: 100%;
      }

      [hidden] {
        display: none !important;
      }

      .wrap {
        width: min(
          calc(100% - 30px),
          820px
        );

        margin: 0 auto;

        padding:
          42px
          0
          90px;
      }

      /* Header */

      .site-header {
        padding:
          18px
          0
          34px;

        text-align: center;
      }

      .site-title {
        color: inherit;
        text-decoration: none;

        font-size: clamp(
          34px,
          6vw,
          48px
        );

        font-weight: 500;
        line-height: 1;
        letter-spacing: -0.04em;
      }

      .filter-nav {
        display: flex;
        align-items: center;
        justify-content: center;

        gap: 8px;
        margin-top: 24px;
      }

      .filter-button,
      .contact-link {
        width: 43px;
        height: 43px;

        border: 0;
        border-bottom:
          1.5px solid transparent;

        padding: 0;

        display: grid;
        place-items: center;

        background: transparent;
        color: var(--black);

        text-decoration: none;
        cursor: pointer;
      }

      .filter-button svg,
      .contact-link svg {
        width: 31px;
        height: 31px;
        display: block;
      }

      .filter-button:hover,
      .contact-link:hover,
      .filter-button.is-active {
        border-bottom-color:
          var(--black);
      }

      .contact-link {
        margin-left: 13px;
      }

      /* Posts */

      .projects {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .post {
        border:
          1.5px solid
          var(--black);

        background:
          transparent;
      }

      .post-summary {
        position: relative;

        padding:
          15px
          46px
          15px
          17px;

        list-style: none;
        cursor: pointer;
      }

      .post-summary::-webkit-details-marker {
        display: none;
      }

      .post-summary::marker {
        content: "";
      }

      .post h2 {
        margin: 0;

        font-size: 19px;
        font-weight: 600;
        line-height: 1.35;
        letter-spacing: 0;
      }

      /* Plus and minus */

      .expand-mark {
        position: absolute;

        right: 17px;
        top: 50%;

        width: 13px;
        height: 13px;

        transform:
          translateY(-50%);
      }

      .expand-mark::before,
      .expand-mark::after {
        content: "";
        position: absolute;
        background:
          var(--black);
      }

      .expand-mark::before {
        width: 13px;
        height: 1px;

        left: 0;
        top: 6px;
      }

      .expand-mark::after {
        width: 1px;
        height: 13px;

        left: 6px;
        top: 0;

        transition:
          transform
          120ms
          ease;
      }

      .post[open]
      .expand-mark::after {
        transform:
          rotate(90deg);
      }

      .post[open]
      .post-summary {
        padding-bottom: 5px;
      }

      .post-expanded {
        padding:
          0
          17px
          18px;
      }

      .post-body {
        max-width: 680px;
        margin: 0;

        font-size: 18px;
        font-weight: 500;
        line-height: 1.48;
      }

      .post-body p {
        margin:
          0
          0
          0.85em;
      }

      .post-body p:last-child {
        margin-bottom: 0;
      }

      .post-body h2,
      .post-body h3 {
        margin:
          1.25em
          0
          0.45em;

        font-size: 19px;
        font-weight: 600;
      }

      .post-body blockquote {
        margin:
          1em
          0;

        padding-left: 15px;

        border-left:
          1.5px solid
          var(--black);
      }

      .post-body a {
        color: inherit;

        text-decoration-thickness:
          1px;

        text-underline-offset:
          3px;
      }

      /* Media */

      .entry-image,
      .entry-video {
        width: 100%;
        max-width: 680px;

        margin:
          7px
          0
          18px;
      }

      .entry-audio {
        display: block;

        width: min(
          100%,
          680px
        );

        height: 42px;

        margin:
          7px
          0
          18px;
      }

      /* Coloured g letters */

      .special-letter {
        color: inherit;
      }

      .letter-g-header {
        color:
          var(--letter-pink);
      }

      /* Mobile */

      @media (
        max-width: 680px
      ) {
        body {
          font-size: 17px;
        }

        .wrap {
          width:
            calc(100% - 18px);

          padding:
            25px
            0
            65px;
        }

        .site-header {
          padding:
            15px
            0
            25px;
        }

        .filter-nav {
          margin-top: 18px;
        }

        .post-summary {
          padding:
            13px
            42px
            13px
            14px;
        }

        .post[open]
        .post-summary {
          padding-bottom: 4px;
        }

        .post-expanded {
          padding:
            0
            14px
            16px;
        }

        .post h2 {
          font-size: 18px;
        }

        .post-body {
          font-size: 17px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrap">
      <slot />
    </div>

    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', (user) => {
          const hash = window.location.hash;

          const isIdentityLink =
            hash.includes('invite_token=') ||
            hash.includes('confirmation_token=') ||
            hash.includes('recovery_token=') ||
            hash.includes('email_change_token=');

          if (isIdentityLink) {
            window.netlifyIdentity.open();
          }

          if (!user) {
            window.netlifyIdentity.on('login', () => {
              window.location.href = '/admin/';
            });
          }
        });
      }
    </script>
  </body>
</html>