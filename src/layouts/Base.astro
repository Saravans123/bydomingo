---
interface Props { title?: string; description?: string }
const { title = 'bydomingo', description = 'Poetry, robots, music and video by Domingo.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title === 'bydomingo' ? title : `${title} — bydomingo`}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
  <style is:global>
    :root{--paper:#efede6;--card:#f8f6f0;--ink:#181817;--muted:#68665f}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:"Crimson Pro",Georgia,serif}
    a{color:inherit}
    img,video{max-width:100%;display:block}
    button,input,textarea,select{font:inherit}
    .wrap{max-width:1280px;margin:auto;padding:20px 24px 60px}
    .site-header{height:86px;position:relative}
    .logo{position:absolute;left:75%;top:28px;transform:translateX(-50%);font-size:25px;font-weight:600;letter-spacing:-.035em;white-space:nowrap;text-decoration:none}
    .utility-row{display:flex;align-items:center;justify-content:space-between;margin:0 0 10px;padding:0}
    .categories{display:flex;gap:12px;align-items:center;margin:0;padding:0}
    .categories a,.contact-link{width:48px;height:48px;color:inherit;text-decoration:none;display:grid;place-items:center}
    .categories svg{width:40px;height:40px;display:block;transition:transform .15s ease}
    .contact-link svg{width:38px;height:38px;display:block;transition:transform .15s ease}
    .categories a:hover svg,.contact-link:hover svg{transform:translateY(-2px)}
    .projects{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}
    .card{grid-column:span 4;border:1.5px solid;background:var(--card);min-height:260px;display:flex;flex-direction:column;text-decoration:none;overflow:hidden}
    .card.small{grid-column:span 3}.card.medium{grid-column:span 4}.card.large{grid-column:span 7}.card.wide{grid-column:span 12}
    .card-image{width:100%;height:240px;object-fit:cover;border-bottom:1.5px solid}
    .card.large .card-image{height:310px}.card.wide .card-image{height:380px}
    .placeholder{height:240px;border-bottom:1.5px solid;display:grid;place-items:center;background:repeating-linear-gradient(45deg,transparent 0 18px,rgba(0,0,0,.045) 18px 19px)}
    .placeholder svg{width:92px;height:92px}
    .card-copy{padding:18px;height:100%;display:flex;flex-direction:column}
    .kind{font-size:14px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;margin:0 0 12px;color:var(--muted)}
    h1,h2,p{margin-top:0}
    .card h2{font-size:31px;line-height:1;margin:0 0 12px;font-weight:650;letter-spacing:-.025em}
    .card p{font-size:19px;line-height:1.3;margin:0}
    .meta{margin-top:auto;border-top:1px solid;padding-top:9px;font-size:12px;font-weight:600;letter-spacing:.07em}
    .page-title{font-size:clamp(42px,8vw,94px);line-height:.9;letter-spacing:-.055em;margin:30px 0 40px;font-weight:600}
    .entry{max-width:820px;margin:20px auto 100px}
    .entry .lead{font-size:25px;color:var(--muted)}
    .entry-body{font-size:23px;line-height:1.5}
    .entry-body img{margin:30px 0}
    .entry-media{margin:28px 0;width:100%}
    .back{display:inline-block;margin:15px 0;text-decoration:none;border-bottom:1px solid}
    footer{font-size:13px;margin-top:34px;text-align:right}
    @media(max-width:800px){
      .logo{left:auto;right:0;transform:none}.projects{grid-template-columns:1fr}.card,.card.small,.card.medium,.card.large,.card.wide{grid-column:1/-1}.categories{gap:4px}.wrap{padding:14px}.card-image,.card.large .card-image,.card.wide .card-image{height:240px}
    }
  </style>
</head>
<body>
  <div class="wrap"><slot /></div>
</body>
</html>
