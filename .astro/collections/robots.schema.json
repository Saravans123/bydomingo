{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "default": "",
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "blocks": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "text"
              },
              "text": {
                "type": "string"
              },
              "alignment": {
                "default": "left",
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "image"
              },
              "src": {
                "type": "string"
              },
              "alt": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "size": {
                "default": "medium",
                "type": "string",
                "enum": [
                  "small",
                  "medium",
                  "large",
                  "full"
                ]
              },
              "alignment": {
                "default": "center",
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              }
            },
            "required": [
              "type",
              "src"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "audio"
              },
              "src": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "size": {
                "default": "large",
                "type": "string",
                "enum": [
                  "small",
                  "medium",
                  "large",
                  "full"
                ]
              },
              "alignment": {
                "default": "center",
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              }
            },
            "required": [
              "type",
              "src"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "video"
              },
              "src": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "size": {
                "default": "large",
                "type": "string",
                "enum": [
                  "small",
                  "medium",
                  "large",
                  "full"
                ]
              },
              "alignment": {
                "default": "center",
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              }
            },
            "required": [
              "type",
              "src"
            ]
          }
        ]
      }
    },
    "featured": {
      "type": "boolean"
    },
    "size": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "wide"
      ]
    },
    "image": {
      "type": "string"
    },
    "audio": {
      "type": "string"
    },
    "video": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "materials": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ]
}