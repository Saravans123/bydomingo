{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "size": {
      "default": "medium",
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "wide"
      ]
    },
    "image": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "audio": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date",
    "summary"
  ]
}